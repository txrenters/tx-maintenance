# Copy to /opt/tx-maintenance/.env.docker on the VPS (chmod 600). This is the
# Laravel environment handed to every container.
#
# Start from Azure's App Settings for the txrenters web app, verbatim -- above
# all APP_KEY: a new key logs everyone out and breaks signed URLs and anything
# stored with encrypted casts. Then override ONLY the keys below.

APP_ENV=production
APP_DEBUG=false
APP_URL=https://maintenance.texasrenters.com

# --- Database: the VPS host's MySQL over its Unix socket ---------------------
# docker-compose.yml mounts /var/run/mysqld into every container. DB_HOST is
# ignored when DB_SOCKET is set. Create the database and user on the host.
DB_CONNECTION=mysql
DB_SOCKET=/var/run/mysqld/mysqld.sock
DB_HOST=localhost
DB_DATABASE=txmaintenance
DB_USERNAME=txmaintenance
DB_PASSWORD=
# Azure MySQL needs TLS; a local socket does not. Remove MYSQL_ATTR_SSL_CA
# (and MYSQL_ATTR_SSL_VERIFY_SERVER_CERT) entirely rather than leaving them
# blank: config/database.php passes an empty string through to PDO.

# --- Queue ----------------------------------------------------------------
# Must exceed the worker's --timeout=720, or a long Jobber import is handed to
# a second worker while the first is still running it.
DB_QUEUE_RETRY_AFTER=780

# --- Reverb -----------------------------------------------------------------
# The browser reaches Reverb through maintenance.texasrenters.com/app (host
# nginx -> web -> reverb). The app itself reaches it container-to-container,
# so the server-side host/port/scheme are the internal ones.
BROADCAST_CONNECTION=reverb
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=maintenance.texasrenters.com
# REVERB_APP_ID / REVERB_APP_KEY / REVERB_APP_SECRET: keep Azure's values, and
# keep REVERB_APP_KEY equal to VITE_REVERB_APP_KEY in .env.

# --- Logs -------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single

# --- SMS master switch (TwilioService) ----------------------------------------
# false = no text leaves this deployment, whatever the feature flags say.
# SMS_ALLOWLIST (comma-separated) narrows sending to those numbers only.
# Keep false until cutover, after Azure's worker and scheduler are stopped.
SMS_ENABLED=false
SMS_ALLOWLIST=

# --- Callback URLs: must point at THIS host at cutover -------------------------
# Copied from Azure they still name txrenters.azurewebsites.net. Also repoint the
# Twilio number webhooks, the Jobber app callback and tx-chatbot's
# MAINTENANCE_APP_URL (support.texasrenters.com) by hand.
# TWILIO_STATUS_CALLBACK_URL=https://maintenance.texasrenters.com/...
# JOBBER_CALLBACK_URL=https://maintenance.texasrenters.com/...

# --- Support app (chatbot hub) ------------------------------------------------
# On any copy of production data, keep TEST_MODE=true: only the allowlisted
# numbers are ever sent to the support app (empty list = nothing is sent).
CHATBOT_HUB_ENABLED=false
CHATBOT_HUB_URL=
CHATBOT_HUB_PHONE=
CHATBOT_HUB_TOKEN=
CHATBOT_HUB_WEBHOOK_SECRET=
CHATBOT_HUB_TEST_MODE=true
CHATBOT_HUB_ALLOWED_PHONES=
