APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
APP_PORT=8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database
# Default to SQLite for quick local setup. Uncomment the MySQL block for Sail/Docker.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=mysql
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=sail
# DB_PASSWORD=password

# Sail/Docker host port forwarding (avoid clashing with local services)
FORWARD_DB_PORT=3307
FORWARD_REDIS_PORT=6380

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_ENCRYPTION=tls
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_MAILBOX=workorders@texasrenters.com
MICROSOFT_JOB_REMINDER_MAILBOX=service@txhomemp.com
MICROSOFT_INVOICES_MAILBOX=invoices@texasrenters.com
INVOICES_MAILBOX_AUTO_REPLY_ENABLED=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Third-party integrations (leave blank by default)
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_STATUS_CALLBACK_URL=
MAINTENANC_TWILIO_PHONE_NUMBER=

# SMS features default ON in production; keep them OFF in dev environments so
# a local run never texts real vendors/owners/tenants.
SCHEDULE_FOLLOWUP_SMS_ENABLED=false
OWNER_ASSIGNMENT_SMS_ENABLED=false
OWNER_SCHEDULE_SMS_ENABLED=false
OWNER_SERVICE_REQUEST_SMS_ENABLED=false
TENANT_PORTAL_SMS_ENABLED=false
EMERGENCY_SMS_ENABLED=false
DESCRIPTION_CHANGE_SMS_ENABLED=false
HOA_VIOLATION_SMS_ENABLED=false
TENANT_VENDOR_FOLLOWUP_SMS_ENABLED=false
TENANT_ASSIGNMENT_SMS_ENABLED=false
TENANT_SCHEDULE_SMS_ENABLED=false
TENANT_SCHEDULE_FOLLOWUP_SMS_ENABLED=false
TENANT_INTAKE_EMAIL_ENABLED=false
OWNER_INTAKE_EMAIL_ENABLED=false
TENANT_INTAKE_SMS_ENABLED=false
TENANT_EASY_FIX_SMS_ENABLED=false

PROPERTYWARE_URL=
PROPERTYWARE_USERNAME=
PROPERTYWARE_PASSWORD=
PROPERTYWARE_CLIENT_ID=
PROPERTYWARE_CLIENT_SECRET_KEY=
PROPERTYWARE_SYSTEM_ID=

MEMORY_LIMIT=1024M

# AI (vendor recommendation). Provider auto-selects Azure if AZURE_OPENAI_* set, else OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL="gpt-5.5"

# Jobber integration
JOBBER_CALLBACK_URL=
JOBBER_CLIENT_ID=
JOBBER_SECRET=
JOBBER_API_VERSION=
# Vendors whose work orders the boards hide when the Vendor filter is THMP
# (THMP is tagged on them only to create the Jobber job). Comma-separated
# exact names; blank turns the rule off. Default: Jimmie Gendke SFA
JOBBER_THMP_FILTER_HIDDEN_VENDORS=
# Logins (emails) that rule applies to; everyone else sees every work order
# under the THMP filter. Comma-separated; blank = nobody.
# Default: xservice@txhomemp.com
JOBBER_THMP_FILTER_USERS=

# Reverb (WebSockets)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# TexasRenters Desktop client. Name and icon default to APP_NAME and /logo.png.
# The websocket details below are resolved on the user's laptop, so they must be
# publicly reachable — unset, the host falls back to the host in APP_URL, NOT to
# REVERB_HOST, which is usually internal. Set DESKTOP_REVERB_* only when Reverb
# lives somewhere other than this application's own domain.
DESKTOP_APP_NAME=
DESKTOP_ICON_URL=
DESKTOP_SETUP_TOKEN_TTL=15
DESKTOP_REVERB_APP_KEY=
DESKTOP_REVERB_HOST=
DESKTOP_REVERB_PORT=
DESKTOP_REVERB_SCHEME=

# Staff desktop notifications. Off, events still reach the in-app bell; only
# the broadcast to the desktop client stops. See config/staff_notifications.php
# for which events notify whom.
STAFF_DESKTOP_NOTIFICATIONS_ENABLED=true
STAFF_DESKTOP_NOTIFY_CAUSER=false

# Internal AI filter: drop courtesy closers ("thank you") from awaiting-reply
# counts. Sends nothing outward; on by default, set false to switch off.
COURTESY_CLOSER_FILTER_ENABLED=true

# Owner/tenant messaging through tx-chatbot. Vendors keep their existing transport.
CHATBOT_HUB_ENABLED=false
CHATBOT_HUB_URL=
CHATBOT_HUB_TOKEN=
CHATBOT_HUB_WEBHOOK_SECRET=
CHATBOT_HUB_PHONE=
