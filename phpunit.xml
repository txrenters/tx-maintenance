<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <!-- Never reach for a real Reverb server from a test run. -->
        <env name="BROADCAST_CONNECTION" value="log"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_DATABASE" value="txrenter_test"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="OPENAI_API_KEY" value=""/>
        <env name="ANTHROPIC_API_KEY" value=""/>
        <env name="AZURE_OPENAI_API_KEY" value=""/>
        <env name="AZURE_OPENAI_URL" value=""/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <!-- SMS features are ON by default in production; force them OFF in
             tests so a test run can never text a real person. -->
        <env name="SCHEDULE_FOLLOWUP_SMS_ENABLED" value="false"/>
        <env name="OWNER_ASSIGNMENT_SMS_ENABLED" value="false"/>
        <env name="OWNER_SCHEDULE_SMS_ENABLED" value="false"/>
        <env name="OWNER_SERVICE_REQUEST_SMS_ENABLED" value="false"/>
        <env name="TENANT_PORTAL_SMS_ENABLED" value="false"/>
        <env name="HOA_VIOLATION_SMS_ENABLED" value="false"/>
        <env name="TENANT_VENDOR_FOLLOWUP_SMS_ENABLED" value="false"/>
        <env name="TENANT_ASSIGNMENT_SMS_ENABLED" value="false"/>
        <env name="TENANT_SCHEDULE_SMS_ENABLED" value="false"/>
        <env name="TENANT_SCHEDULE_FOLLOWUP_SMS_ENABLED" value="false"/>
        <env name="TENANT_INTAKE_EMAIL_ENABLED" value="false"/>
        <env name="TENANT_INTAKE_SMS_ENABLED" value="false"/>
        <env name="DESCRIPTION_CHANGE_SMS_ENABLED" value="false"/>
        <env name="JOBBER_JOB_CREATE_ENABLED" value="false"/>
        <env name="VENDOR_AUTO_ASSIGN_ENABLED" value="false"/>
        <env name="JOBBER_VENDOR_NOTIFY_ENABLED" value="false"/>
    </php>
</phpunit>
