# Copy to /opt/tx-maintenance/.env on the VPS. Read by Docker Compose itself
# for ${...} interpolation -- NOT the Laravel environment (that is .env.docker).

APP_SLUG=txmaint
APP_VERSION=latest
HTTP_PORT_RANGE=8090-8091

# Leave empty while Azure is production. `queue` alone may run for a
# CHATBOT_HUB_TEST_MODE test; `queue,scheduler` only at cutover, after Azure's
# worker and scheduler are stopped -- see docker-compose.yml.
COMPOSE_PROFILES=

# Baked into the JS bundle at build time; changing them needs a redeploy.
VITE_APP_NAME="TexasRenters.com Maintenance"
VITE_REVERB_APP_KEY=
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# true = the PHP containers have no internet access (nothing can be sent).
# Keep true until cutover; see docker-compose.yml.
ISOLATE_APP=true
